# StandGuard response headers — rebuilt 2026-09-21, amended 2026-10-05
#
# The Content-Security-Policy below was written from what the pages actually
# load, audited across every generated file:
#   script-src  'self'            — no inline script, no CDN, no analytics.
#                                   Every handler is bound in /assets/js/*.
#   style-src   + 'unsafe-inline' — the pages ported from the previous
#                                   single-file site use inline style
#                                   attributes throughout. Removing them is
#                                   tracked on /status as a planned change;
#                                   until then, claiming a stricter policy
#                                   than the pages can keep would just break
#                                   the site.
#   font-src    fonts.gstatic.com — Google Fonts. Self-hosting them (and
#                                   dropping both Google origins) is also on
#                                   the planned list.
#   img-src     + img.youtube.com — Academy video thumbnails.
#   media-src   + archive.org     — SignGuard's ASL dictionary clips
#               + *.archive.org     (/learn/signguard). ADDED 2026-10-05.
#                                   Both entries are needed: a request to
#                                   archive.org/download/... is answered with
#                                   a redirect to a storage node such as
#                                   ia801504.us.archive.org, and CSP is
#                                   checked against the redirect target too,
#                                   so naming only the parent would still
#                                   refuse the clip.
#   connect-src + archive.org     — the one fetch SignGuard makes, asking
#                                   archive.org/metadata/<item> which files
#                                   an item holds. No other site is read.
#                                   The four XPR Network RPC hosts below are
#                                   for the read-only account check and are
#                                   unrelated.
#
# The jsDelivr entry that briefly sat in media-src is gone. It was there for
# a motion-capture archive whose clips turned out to be renders of a 3D model
# rather than a person; that page was pulled the same day, so the origin is
# no longer loaded and no longer allowed.
#
# Permissions-Policy autoplay was () — disabled everywhere. SignGuard starts a
# muted clip the moment a word is chosen, so it is now (self): this site may
# autoplay, embedded third parties still may not. Nothing else on the site
# autoplays, and the clip is muted, so no page starts making noise on its own.
#
# No HSTS yet. It is deliberately absent: it must not be enabled until every
# subdomain that needs to serve HTTPS has been verified, because it is hard
# to withdraw once browsers have cached it.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https://img.youtube.com; media-src 'self' https://archive.org https://*.archive.org; connect-src 'self' https://archive.org https://proton.eosusa.io https://api.protonnz.com https://proton.cryptolions.io https://api-xprnetwork-main.saltant.io; form-action 'self'; frame-ancestors 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'; manifest-src 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), ambient-light-sensor=(), autoplay=(self), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Hashed-forever assets do not exist yet, so styles and scripts get a short
# cache with revalidation rather than a long one that strands a fix.
/assets/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/img/*
  Cache-Control: public, max-age=604800

# HTML is revalidated every time. The old site sent no-store on the whole
# document; this keeps content current without refetching on every navigation.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
