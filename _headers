# StandGuard response headers — rebuilt 2026-09-21, amended 2026-10-05
#
# The Content-Security-Policy below was written from what the pages actually
# load, audited across every generated file:
#   script-src  'self'            — no inline script, no CDN. Every handler
#                                   is bound in /assets/js/*.
#               + static.cloudflareinsights.com — Cloudflare Web Analytics
#                                   beacon (ADDED 2026-10-17, operator: "I need
#                                   analytics to see who visits and how
#                                   often"). Cloudflare injects it; it was
#                                   blocked here until now (REA Lab job 2).
#                                   It reports to this site's own
#                                   /cdn-cgi/rum, which connect-src 'self'
#                                   already allows (developers.cloudflare.com
#                                   /web-analytics/faq, "What do I need to
#                                   add to my CSP"). No cookies, no browser
#                                   storage (…/web-analytics/data-metrics/
#                                   core-web-vitals). Previous text: "no
#                                   analytics" — superseded 2026-10-17.
#   style-src   + 'unsafe-inline' — the pages ported from the previous
#                                   single-file site use inline style
#                                   attributes throughout. Splitting
#                                   style-src-elem from style-src-attr is a
#                                   later clean-up; until then, claiming a
#                                   stricter policy than the pages can keep
#                                   would just break the site.
#   font-src    'self' only       — fonts are served from /assets/fonts since
#                                   2026-10-28. Both Google Fonts origins were
#                                   removed from style-src and font-src on
#                                   2026-11-10 (SG-40); no page loaded them.
#   img-src     + img.youtube.com — Academy video thumbnails.
#   media-src   + archive.org     — SignGuard's ASL dictionary clips
#               + *.archive.org     (/learn/signguard). ADDED 2026-10-05.
#                                   Both entries are needed: a request to
#                                   archive.org/download/... is answered with
#                                   a redirect to a storage node such as
#                                   ia801504.us.archive.org, and CSP is
#                                   checked against the redirect target too,
#                                   so naming only the parent would still
#                                   refuse the clip.
#   connect-src + archive.org     — the one fetch SignGuard makes, asking
#                                   archive.org/metadata/<item> which files
#                                   an item holds. No other site is read.
#                                   The four XPR Network RPC hosts below are
#                                   for the read-only account check and are
#                                   unrelated.
#
# The jsDelivr entry that briefly sat in media-src is gone. It was there for
# a motion-capture archive whose clips turned out to be renders of a 3D model
# rather than a person; that page was pulled the same day, so the origin is
# no longer loaded and no longer allowed.
#
# Permissions-Policy autoplay was () — disabled everywhere. SignGuard starts a
# muted clip the moment a word is chosen, so it is now (self): this site may
# autoplay, embedded third parties still may not. Nothing else on the site
# autoplays, and the clip is muted, so no page starts making noise on its own.
#
# HSTS (amended 2026-10-17, REA Lab job 2, GUARD-Project
# REA/reports/lab-job-2-2026-10-17.md): sent for standguard.net ITSELF only —
# max-age one year, NO includeSubDomains and NO preload. This site already
# answers only over https (http -> 301), so pinning it costs nothing. The
# earlier caution still stands for the subdomains: includeSubDomains (and
# preload) wait until every subdomain is verified https-only, because both
# are hard to withdraw once browsers have cached them.
# Previous text, superseded 2026-10-17: "No HSTS yet. It is deliberately
# absent: it must not be enabled until every subdomain that needs to serve
# HTTPS has been verified, because it is hard to withdraw once browsers have
# cached it."
#
# Also 2026-10-17 (same report): ambient-light-sensor removed from
# Permissions-Policy (Chrome rejects the name and logged a warning on every
# page), and Cloudflare's default Access-Control-Allow-Origin: * is detached —
# no other site needs to read these pages.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' https://img.youtube.com; media-src 'self' https://archive.org https://*.archive.org; connect-src 'self' https://archive.org https://proton.eosusa.io https://api.protonnz.com https://proton.cryptolions.io https://api-xprnetwork-main.saltant.io; form-action 'self'; frame-ancestors 'none'; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'none'; manifest-src 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(self), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self "https://www.youtube-nocookie.com"), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
  ! Access-Control-Allow-Origin

# Home page only (SG-39, 2026-11-10): the browser learns about the stylesheet and the title font from
# this header, before it has parsed any HTML; with Early Hints on, Cloudflare sends it as a 103.
/
  Link: </assets/css/v3.css>; rel=preload; as=style, </assets/fonts/cinzel-latin-700-normal.woff2>; rel=preload; as=font; crossorigin

# Hashed-forever assets do not exist yet, so styles and scripts get a short
# cache with revalidation rather than a long one that strands a fix.
/assets/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/img/*
  Cache-Control: public, max-age=604800

# Fonts never change under the same file name, so a year, immutable (SG-40, 2026-11-10).
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Media (the intro film, its poster and captions) and SignGuard's clips: 30 days (SG-40, 2026-11-10).
/assets/media/*
  Cache-Control: public, max-age=2592000

/assets/signguard/*
  Cache-Control: public, max-age=2592000

# Pages are served at /about/, never /about.html, so the old "/*.html" rule matched nothing (audit M15)
# and was removed on 2026-11-10. HTML keeps the zone's default revalidation.

# The Utility Forge sample cover is shown on XPR Agents (xpragents.com/services/13). The site-wide
# Cross-Origin-Resource-Policy: same-origin above blocks that embed, so this one folder allows it
# (MASTER-standguard Now 7; detach syntax: developers.cloudflare.com/pages/configuration/headers/).
/assets/samples/*
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=2592000

# Keep the pages.dev copy of the site out of search results; standguard.net is the real address
# (MASTER-standguard Now 7; pattern from the same Cloudflare page).
https://:project.pages.dev/*
  X-Robots-Tag: noindex
